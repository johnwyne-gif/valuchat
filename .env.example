# ValuChat Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: A secret key for session encryption
# Must be at least 32 characters long
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-this-with-your-own-secret-key-min-32-chars-long

# Set to 'production' for live deployment, 'development' for local testing
FLASK_ENV=development
